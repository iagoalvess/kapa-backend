<Project Sdk="Microsoft.NET.Sdk.Worker">
  <!-- Jobs de fundo. Consome os mesmos services de Backend.Business que a API. -->

  <PropertyGroup>
    <UserSecretsId>backend-worker-template</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Backend.Business\Backend.Business.csproj" />
    <ProjectReference Include="..\Backend.Data\Backend.Data.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Runtime" />
  </ItemGroup>

  <!-- appsettings.Development.json traz segredos de desenvolvimento e o desvio de e-mail
       (Smtp:RedirecionarPara) para uma caixa real. Não pode ir para a imagem: um worker que suba
       como Development por engano manda todo e-mail de produção para essa caixa. -->
  <ItemGroup>
    <Content Update="appsettings.Development.json" CopyToPublishDirectory="Never" />
  </ItemGroup>
</Project>
