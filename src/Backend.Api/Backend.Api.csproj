<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <UserSecretsId>backend-api-template</UserSecretsId>

    <!-- AV0029/AV0030: o analisador do Asp.Versioning sugere AddApiVersioning().AddOpenApi()
         e MapOpenApi().WithDocumentPerVersion(), que ainda não existem nos pacotes estáveis
         10.2.x — ver o comentário em Configuration/ScalarConfig.cs. Fica aqui, e não no
         .editorconfig, porque um dos avisos vem de código gerado dentro de obj/, que os globs
         do .editorconfig não alcançam. Remova quando as APIs forem lançadas. -->
    <NoWarn>$(NoWarn);AV0029;AV0030</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Backend.Business\Backend.Business.csproj" />
    <ProjectReference Include="..\Backend.Data\Backend.Data.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Asp.Versioning.Mvc" />
    <PackageReference Include="Asp.Versioning.Mvc.ApiExplorer" />
    <PackageReference Include="AspNetCore.HealthChecks.NpgSql" />
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" />
    <PackageReference Include="Mapster" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Scalar.AspNetCore" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Runtime" />

    <!-- Necessário para o "dotnet ef" usar este projeto como startup nas migrations. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <!-- appsettings.Development.json carrega segredos de desenvolvimento (JWT, chave do CPF, segredo do
       convite) e o seed do administrador. Ele não pode ir para a imagem: se o container subir como
       Development por engano, liga tudo isso de uma vez e cria um admin com senha publicada no repo.
       O ambiente de desenvolvimento roda da fonte, não do publicado. -->
  <ItemGroup>
    <Content Update="appsettings.Development.json" CopyToPublishDirectory="Never" />
  </ItemGroup>
</Project>
