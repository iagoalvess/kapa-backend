# Copie para .env antes do primeiro "docker compose up".
# O .env é ignorado pelo git — nenhum segredo real entra no repositório.

# Chave de assinatura do JWT. Mínimo 32 caracteres.
# Gere uma nova por ambiente:  openssl rand -base64 48
JWT_CHAVE_SECRETA=troque-esta-chave-por-uma-gerada-com-openssl-rand

# Chave AES-256 dos dados sensíveis (CPF), 32 bytes em Base64.
# Gere com:  openssl rand -base64 32
# PERDER ESTA CHAVE TORNA ILEGÍVEL TODO CPF GRAVADO. Guarde no secret manager.
CRIPTOGRAFIA_CHAVE=

# Administrador criado no primeiro boot. Sem estas duas variáveis, nenhum
# administrador é criado — não existe usuário padrão embutido.
ADMIN_EMAIL=admin@localhost
ADMIN_SENHA=

# E-mails: base dos links de confirmação e redefinição de senha.
APP_NOME=Backend
APP_URL_FRONTEND=http://localhost:3000

# Banco
POSTGRES_DB=backend
POSTGRES_USER=backend
POSTGRES_PASSWORD=backend
POSTGRES_PORT=5432

# API
API_PORT=8080

# Observabilidade: vazio desliga a exportação de traces e métricas.
# Ex.: http://otel-collector:4317
OTEL_EXPORTER_OTLP_ENDPOINT=
